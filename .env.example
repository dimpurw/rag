# Wajib diisi - daftar gratis di https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Model LLM Groq (pilihan lain: llama-3.1-8b-instant, mixtral-8x7b-32768)
LLM_MODEL=llama-3.3-70b-versatile

# Model embedding HuggingFace (jalan lokal, gratis, tanpa API key).
# Pakai model MULTILINGUAL agar dokumen berbahasa Indonesia terbaca dengan benar.
EMBEDDING_MODEL=intfloat/multilingual-e5-small

# Direktori penyimpanan
UPLOAD_DIR=storage/uploads
CHROMA_DIR=storage/chroma_db

# Chunking
CHUNK_SIZE=1200
CHUNK_OVERLAP=200

# Retrieval
RETRIEVAL_K=6

# CORS - pisahkan dengan koma, atau * untuk semua (tidak disarankan di production)
ALLOWED_ORIGINS=http://localhost:3000

# Rate limiting
RATE_LIMIT_PER_MINUTE=20

# Ukuran maksimal file upload (MB)
MAX_UPLOAD_SIZE_MB=20

# API Key untuk proteksi endpoint (opsional). Kosongkan untuk development (tanpa auth).
# WAJIB diisi untuk production. Client kirim via header: X-API-Key
API_KEY=

# Jumlah maksimal giliran percakapan yang diingat per session (chat multi-turn)
MAX_HISTORY_TURNS=5

# App
APP_ENV=development
LOG_LEVEL=INFO
